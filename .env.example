# Neon / Vercel Postgres: use the pooled URL for DATABASE_URL.
# Add ?pgbouncer=true if the host contains "-pooler".
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
# Direct (non-pooled) URL for prisma db push / seed. Can match DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
AI_API_KEY=""
PAYMENT_API_KEY=""
SMS_API_KEY=""
APP_ORIGIN="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="BilAn"
NEXT_PUBLIC_DEMO_MODE="true"
